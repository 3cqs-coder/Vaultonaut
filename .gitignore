node_modules/

# The lockfile is not tracked — dependency versions resolve from the caret ranges in package.json at each
# install, so a fresh install always picks up compatible patch/minor updates.
package-lock.json

# Downloaded engine binary and all runtime data (never commit these)
data/bin/
data/vaults/
data/run/
data/sync/
data/certs/
data/locks/
data/mirror-versions/
data/recovery-exclude/
data/ramdisk-pending/
data/staging/
data/state.json
data/integrity.json
data/settings.json
data/credkey
data/tamper-log.json

# OS cruft
.DS_Store

# Release signing: the PRIVATE key must never be committed. The signed manifest and checksum files are generated
# at release time into the release artifact, not tracked in the source tree, so a dev checkout has no manifest and
# the self-integrity check stays inert during development (no false alarms while editing).
release-signing-key.json
release-manifest.json
release-manifest.sig
SHA256SUMS
SHA256SUMS.sig

data/service.pid

# Test scratch directory (data dir + engine used by the test suite)
.test-data/

docs/*
!docs/README.md

# Native desktop packaging (development-only; the published npm package never includes it).
# Build outputs, the staged app copy (which now contains the bundled Node runtime), and the packaging tool's own
# npm dependencies are regenerated by prepare-sidecar.js and the Tauri build — never committed. Cargo.lock IS
# committed (a binary app pins its exact crate graph, so every platform builds the same dependency versions).
src-tauri/target/
src-tauri/node_modules/
src-tauri/app/
src-tauri/gen/
