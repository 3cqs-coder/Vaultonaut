{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultonaut",
  "version": "../package.json",
  "identifier": "com.3cqs.vaultonaut",
  "build": {
    "frontendDist": "ui-shell",
    "beforeDevCommand": { "script": "node -e \"const fs=require('fs'),path=require('path');const f=['src-tauri/sync-version.js','sync-version.js'].find(x=>fs.existsSync(x));if(f===undefined)throw new Error('sync-version.js not found');require(path.resolve(f))\"", "wait": true },
    "beforeBuildCommand": { "script": "node -e \"const fs=require('fs'),path=require('path');const f=['src-tauri/sync-version.js','sync-version.js'].find(x=>fs.existsSync(x));if(f===undefined)throw new Error('sync-version.js not found');require(path.resolve(f))\"" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vaultonaut",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html",
        "backgroundColor": "#0f1115",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "rpm"],
    "publisher": "3CQS",
    "copyright": "Copyright (C) 3CQS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "app": "app"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    }
  }
}
