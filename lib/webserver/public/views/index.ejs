						<option value="drive">Google Drive</option>
						<option value="dropbox">Dropbox</option>
						<option value="onedrive">Microsoft OneDrive</option>
					</select>
				</label>
				<label class="field field-grow"><span>Name (optional)</span><input type="text" id="cloudOAuthLabel" placeholder="My Drive" autocomplete="off"></label>
