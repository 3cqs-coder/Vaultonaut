					<option value="b2">Backblaze B2</option>
					<option value="webdav">WebDAV</option>
				</select>
			</label>
			<label class="field"><span>Name (optional)</span><input type="text" id="cloudLabel" placeholder="My bucket" autocomplete="off"></label>
			<label class="field"><span>Settings — one <code>key=value</code> per line</span>
				<textarea id="cloudOpts" rows="5" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="region=us-east-1&#10;access_key_id=AKIA…&#10;secret_access_key=…"></textarea>
				<small class="checkhint">Use the field names the backend expects. Secrets such as <code>secret_access_key</code>, <code>key</code>, and <code>pass</code> are recognized and stored encrypted automatically.</small>
			</label>
			<div id="cloudResult" class="tamper-result" hidden></div>
			<div class="dialog-actions">
				<button type="button" value="cancel" class="ghost-btn">Close</button>
				<button value="ok" class="primary-btn">Add</button>
			</div>
		</form>
	</dialog>

