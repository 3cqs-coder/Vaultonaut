<!doctype html>
<html lang="en" data-theme="auto">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title><%= appName %></title>
	<link rel="icon" href="/icon.svg" type="image/svg+xml">
	<script src="/js/theme-boot.js"></script>
	<link rel="stylesheet" href="/fonts/fonts.css">
	<link rel="stylesheet" href="/css/app.css">
</head>
<body data-app-name="<%= appName %>" data-cli="<%= cli %>" data-pack-ext="<%= packExt %>">
	<a class="skip-link" href="#main">Skip to content</a>
	<div class="app">
	<button id="railToggle" class="rail-toggle" aria-label="Menu" aria-controls="rail" aria-expanded="false"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
	<div id="railScrim" class="rail-scrim" hidden></div>
	<aside class="rail" id="rail">
		<div class="brand">
			<img class="logo" src="/icon.svg" alt="" width="30" height="30">
			<div class="brand-text"><span class="brand-name"><%= appName %></span><span class="version">v<%= version %></span></div>
		</div>
		<nav class="rail-nav">
			<span class="rail-item active" aria-current="page"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9h18"/></svg> Vaults <span id="vaultCount" class="rail-count"></span></span>
			<button id="settingsBtn" class="rail-item" title="Settings, security features, and maintenance"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 13a7.5 7.5 0 0 0 0-2l2-1.5-2-3.4-2.3 1a7.5 7.5 0 0 0-1.7-1L15 3.2h-4l-.4 2.4a7.5 7.5 0 0 0-1.7 1l-2.3-1-2 3.4L6.6 11a7.5 7.5 0 0 0 0 2l-2 1.5 2 3.4 2.3-1a7.5 7.5 0 0 0 1.7 1l.4 2.4h4l.4-2.4a7.5 7.5 0 0 0 1.7-1l2.3 1 2-3.4-2-1.5Z"/></svg> Settings</button>
			<button id="helpBtn" class="rail-item" title="Open the guide — how everything works, searchable"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.8.4-1.1 1-1.1 1.8M12 17h.01"/></svg> Help</button>
		</nav>
		<div class="rail-safe">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
			<div><b>You're protected</b><span>Files stay encrypted even while a vault is open.</span></div>
		</div>
		<div class="rail-spacer"></div>
		<div class="rail-foot">
			<button id="lockAllBtn" class="rail-item" title="Lock (unmount) every mounted vault now — or press Ctrl/Cmd+Shift+L to panic-lock instantly"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg> Lock all</button>
			<button id="refreshBtn" class="rail-item" title="Refresh the vault list"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v5h-5"/></svg> Refresh</button>
			<button id="themeToggle" class="rail-item" title="Change theme — system, light, dark, or sepia" aria-label="Change theme"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg> Theme</button>
			<button id="logoutBtn" class="rail-item" title="Sign out of the web interface" hidden><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12H3M9 6l-6 6 6 6M14 4h5a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-5"/></svg> Log out</button>
		</div>
	</aside>

	<main class="main" id="main" tabindex="-1">
		<div class="main-top">
			<div class="main-title"><h1>Your vaults</h1><p>An encrypted drive for your files. Unlock it when you need it, lock it when you don't.</p></div>
			<button type="button" id="newVaultBtn" class="primary-btn new-vault-btn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg> New vault</button>
		</div>
		<!-- Environment readiness -->
		<section id="env" class="banner" role="status" aria-live="polite" hidden></section>
		<section id="integrity" class="banner" role="status" aria-live="polite" hidden></section>
		<p id="bioHint" class="bio-hint" hidden></p>

		<!-- Vaults -->
		<section class="panel vaults-panel">
			<div id="vaults" class="cards" role="list"></div>
			<p id="noVaults" class="muted" hidden>No vaults yet — create one below, or add an existing vault folder.</p>
		</section>

		<!-- Create / Add -->
		<section class="panel">
			<div class="panel-head"><h2>Create a vault</h2></div>
			<form id="createForm" class="form" autocomplete="off">
				<label class="field">
					<span>Name or location</span>
					<input type="text" id="createPath" placeholder="Personal" required>
					<small class="hint" id="createHint">Enter a name to store it in the vaults folder, or type a full path. Copy a vault folder to any machine to take it with you.</small>
				</label>
				<div class="row">
					<label class="field">
						<span id="createPassLabel">Password</span>
						<input type="text" class="mask" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" id="createPass" aria-labelledby="createPassLabel" required>
						<div class="strength" id="createPassMeter" hidden><span class="strength-bar"><i></i></span><span class="strength-text"></span></div>
					</label>
					<label class="field">
						<span>Confirm password</span>
						<input type="text" class="mask" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" id="createPass2" required>
					</label>
				</div>
				<p class="hint">File and directory names are always encrypted — a vault never reveals what it contains.</p>
				<details class="advanced">
					<summary>Import an existing folder</summary>
					<label class="field">
						<span>Folder to import (optional)</span>
						<div class="backup-dest">
							<input type="text" id="createImport" class="backup-dest-path" placeholder="Choose a folder to copy into the new vault" readonly>
							<button type="button" id="createImportBrowse" class="ghost-btn">Browse…</button>
							<button type="button" id="createImportClear" class="link-btn" hidden>Clear</button>
						</div>
						<small class="checkhint">Copies that folder's files into the new vault, encrypting them. Your originals are left untouched — delete them yourself once you have checked the vault opens and holds everything.</small>
					</label>
				</details>
				<details class="advanced">
					<summary>Store on cloud storage (advanced)</summary>
					<label class="field">
						<span>Cloud storage</span>
						<select id="createCloud"><option value="">This computer (a normal local vault)</option></select>
						<small class="checkhint">Keeps the vault's encrypted data on a cloud remote (S3, Backblaze B2, WebDAV, …) instead of this computer, while it still mounts here. Only ciphertext ever reaches the cloud. Needs a network connection to open.</small>
					</label>
					<label class="field" id="createCloudPathRow" hidden>
						<span>Folder on the cloud (optional)</span>
						<input type="text" id="createCloudPath" placeholder="e.g. vaults/personal" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
					</label>
					<label class="checkfield" id="createWormRow" hidden>
						<input type="checkbox" id="createWorm">
						<span>Tamper‑proof (Object Lock)
							<small class="checkhint">Locks every saved version so it cannot be deleted or overwritten for a set time — strong protection against ransomware and accidental or malicious deletion. Works on S3 or S3‑compatible storage only (Amazon S3, or Backblaze B2 through its S3 endpoint). Edits and deletes become new locked versions, so storage grows over time; you can add a lifecycle rule at your provider to reclaim space once the lock window passes.</small>
						</span>
					</label>
					<label class="field" id="createWormDaysRow" hidden>
						<span>Keep each version locked for (days)</span>
						<input type="text" id="createWormDays" inputmode="numeric" value="30" data-digits="1">
					</label>
					<div class="my-1"><button type="button" id="createCloudManage" class="link-btn">Manage cloud storage…</button></div>
				</details>
				<details class="advanced">
					<summary>Security level</summary>
					<label class="field">
						<span>Password protection strength</span>
						<select id="createLevel">
							<option value="standard" selected>Standard — opens fast on any device (recommended)</option>
							<option value="high">High — harder to brute-force; a brief pause to unlock</option>
							<option value="max">Maximum — strongest; needs ~½ GB free to open</option>
						</select>
						<small class="checkhint">Sets how hard it is to guess your password by brute force. Higher levels cost an attacker more memory and time per guess, at the price of a slightly slower unlock. This is fixed when the vault is created.</small>
					</label>
				</details>
				<button type="submit" class="primary-btn">Create vault</button>
			</form>

			<div class="divider"><span>or</span></div>

			<form id="addForm" class="form inline dropzone">
				<label class="field grow">
					<span>Add an existing vault folder</span>
					<input type="text" id="addPath" placeholder="Click Browse to pick a .vault folder, or paste its path" required>
					<small class="hint">Use Browse to pick a .vault folder (external drives included), or paste its path. Dragging a folder in opens the picker (browsers hide a dropped folder's real location).</small>
				</label>
				<button type="button" id="browseBtn" class="ghost-btn">Browse…</button>
				<button type="submit" class="ghost-btn">Add</button>
			</form>
			<p class="hint mt-3">Have a vault that was <strong>split across places</strong>? <button type="button" id="rebuildOpen" class="link-btn">Rebuild it from its shards…</button></p>
				<p class="hint mt-3">Received a <strong>shared vault file</strong>? <button type="button" id="openSharedBtn" class="link-btn">Open a shared file…</button> — it is unpacked into your vaults folder and added to the list in one step, ready to open with its password.</p>
				<div id="openSharedProgress" class="progress" hidden>
					<div class="progress-track"><div id="openSharedBarFill" class="progress-fill"></div></div>
					<div id="openSharedBarText" class="progress-text"></div>
				</div>
				<div id="openSharedResult" class="tamper-result" hidden></div>
		</section>
	</main>
	</div><!-- /.app -->

	<!-- Password prompt for mounting -->
	<dialog id="mountDialog" class="dialog">
		<form method="dialog" id="mountForm" autocomplete="off">
			<h3>Unlock vault</h3>
			<p id="mountName" class="muted"></p>
			<label class="field">
				<span>Password</span>
				<input type="text" class="mask" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" id="mountPass" autofocus>
			</label>
			<details class="advanced" id="mountSharesWrap" hidden>
				<summary>Unlock with threshold-key shares</summary>
				<label class="field"><span>Paste the shares (one per line)</span><textarea id="mountShares" rows="3" placeholder="vds1.2.1.…&#10;vds1.2.3.…"></textarea></label>
			</details>
			<details class="advanced">
				<summary>Unlock with a read link (read-only)</summary>
				<label class="field"><span>Paste a read link</span><input type="text" class="mask" id="mountReadCap" placeholder="vdrc1.…" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
			</details>
			<label class="checkfield">
				<input type="checkbox" id="mountReadOnly">
				<span>Mount read-only</span>
			</label>
			<p class="mounthint">Everything just works — play media, edit files, run apps. Nothing decrypted is ever written to disk; the small write buffer is kept in memory.</p>
			<details class="advanced">
				<summary>Advanced</summary>
				<label class="checkfield">
					<input type="checkbox" id="mountWorkingDisk">
					<span>Full working disk
						<small class="checkhint">For a database or virtual‑machine / disk‑image file that constantly rewrites one large file. It also caches reads, so it uses a little more memory. Once you mount with this on, it is remembered for this vault, so later mounts use it automatically.</small>
					</span>
				</label>
				<label class="checkfield">
					<input type="checkbox" id="mountStreaming">
					<span>Streaming (minimal)
						<small class="checkhint">Caches nothing and uses the least memory, but cannot rewrite a file in place, so some media apps and databases will not work.</small>
					</span>
				</label>
				<% if (isMac) { %>
				<label class="checkfield">
					<input type="checkbox" id="mountFuseBackend">
					<span>Use the SMB backend
						<small class="checkhint">Try this if copying a large file into the vault fails with an I/O error (&ldquo;&minus;36&rdquo;). It mounts the drive through a different macOS transport (SMB instead of NFS), which avoids a bug in some FUSE&#8209;T driver versions. Remembered for this vault.</small>
					</span>
				</label>
				<% } %>
			</details>
			<input type="file" id="mountKeyfile" hidden>
			<div class="dialog-actions">
				<button type="button" value="cancel" class="ghost-btn">Cancel</button>
				<button type="button" id="mountKeyfileBtn" class="ghost-btn" hidden>Unlock with keyfile</button>
				<button type="button" id="mountBio" class="ghost-btn" hidden>Unlock with Touch ID</button>
				<button value="ok" class="primary-btn" id="mountGo">Mount</button>
			</div>
		</form>
	</dialog>

	<dialog id="passwdDialog" class="dialog">
		<form method="dialog" id="passwdForm" autocomplete="off">
			<h3>Change password</h3>
			<p id="passwdName" class="muted"></p>
			<label class="field">
				<span>Current password</span>
				<input type="text" class="mask" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" id="passwdOld" autofocus required>
			</label>
			<label class="field">
				<span id="passwdNewLabel">New password</span>
				<input type="text" class="mask" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" id="passwdNew" aria-labelledby="passwdNewLabel" required>
					<div class="strength" id="passwdNewMeter" hidden><span class="strength-bar"><i></i></span><span class="strength-text"></span></div>
			</label>
			<label class="field">
				<span>Confirm new password</span>
				<input type="text" class="mask" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" id="passwdNew2" required>
			</label>
			<p class="hint">Instant — your files are not re-encrypted. The old password stops working right away.</p>
			<div class="dialog-actions">
				<button type="button" value="cancel" class="ghost-btn">Cancel</button>
				<button value="ok" class="primary-btn">Change password</button>
			</div>
		</form>
	</dialog>

	<dialog id="autostartDialog" class="dialog">
		<form method="dialog" id="autostartForm" autocomplete="off">
			<h3>Start at login</h3>
			<p class="muted">Open the interface automatically each time you log in, and add a launcher icon. It never mounts a vault or stores your password.</p>
			<fieldset class="field-group">
				<legend>Where can it be opened?</legend>
				<label class="radio-row">
					<input type="radio" name="autostartScope" value="local" checked>
					<span class="setting-text"><span class="setting-name">This computer only</span><span class="setting-desc">Recommended. The interface stays private to this computer.</span></span>
				</label>
				<label class="radio-row">
					<input type="radio" name="autostartScope" value="network">
					<span class="setting-text"><span class="setting-name">This computer and my other devices</span><span class="setting-desc">Open a vault from your phone or another device on the same network. It uses a secure (https) address and requires a login.</span></span>
				</label>
			</fieldset>
			<div id="autostartPassWrap" hidden>
				<label class="field">
					<span id="autostartPassLabel">Web login password (at least 8 characters)</span>
					<input type="text" class="mask" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" id="autostartPass" aria-labelledby="autostartPassLabel">
					<div class="strength" id="autostartPassMeter" hidden><span class="strength-bar"><i></i></span><span class="strength-text"></span></div>
				</label>
				<p class="hint">Anyone who opens the interface will need this password. You can change it later.</p>
			</div>
			<p class="hint" id="autostartPassHave" hidden>Your existing web login password will be used.</p>
			<p class="hint" id="autostartNetHint" hidden>This takes effect the next time you log in. The address uses a self-signed certificate, so a phone shows a one-time warning to accept. To use it right now, restart the interface on your network.</p>
			<div class="dialog-actions">
				<button type="button" value="cancel" class="ghost-btn">Cancel</button>
				<button value="ok" class="primary-btn">Turn on</button>
			</div>
		</form>
	</dialog>

	<dialog id="confirmDialog" class="dialog">
		<form method="dialog" id="confirmForm">
			<h3 id="confirmTitle">Confirm</h3>
			<p id="confirmMsg" class="muted"></p>
			<label class="field" id="confirmPwField" hidden>
				<span id="confirmPwLabel">Vault password</span>
				<input type="text" class="mask" id="confirmPw" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true">
			</label>
			<label class="field" id="confirmPw2Field" hidden>
				<span id="confirmPw2Label">New password</span>
				<input type="text" class="mask" id="confirmPw2" aria-labelledby="confirmPw2Label" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true">
				<div class="strength" id="confirmPw2Meter" hidden><span class="strength-bar"><i></i></span><span class="strength-text"></span></div>
			</label>
			<div class="dialog-actions">
				<button type="button" value="cancel" class="ghost-btn" id="confirmCancel">Cancel</button>
				<button value="ok" class="primary-btn" id="confirmOk">Confirm</button>
			</div>
		</form>
	</dialog>

	<dialog id="helpDialog" class="dialog help-dialog" aria-label="Help">
		<div class="help-head">
			<strong class="help-title">Guide</strong>
			<label class="help-search">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
				<input type="search" id="helpSearch" placeholder="Search the guide…" autocomplete="off" spellcheck="false" aria-label="Search the guide">
				<span id="helpSearchCount" class="help-search-count" aria-live="polite"></span>
				<button type="button" id="helpPrev" class="help-nav-btn" title="Previous match (Shift+Enter)" aria-label="Previous match" hidden>▲</button>
				<button type="button" id="helpNext" class="help-nav-btn" title="Next match (Enter)" aria-label="Next match" hidden>▼</button>
			</label>
			<button type="button" id="helpClose" class="ghost-btn" value="cancel">Close</button>
		</div>
		<div id="helpMatches" class="help-matches" aria-label="Sections with matches" hidden></div>
		<div id="helpBody" class="help-body" tabindex="0"><p class="muted">Loading…</p></div>
	</dialog>

	<dialog id="settingsDialog" class="dialog">
		<form method="dialog" id="settingsForm">
			<h3>Settings</h3>
			<p class="muted">Preferences for this computer. Your vaults are never affected.</p>

			<div class="settings-group">
				<div class="settings-label">General</div>
				<label class="setting-row">
					<span class="setting-text"><span class="setting-name">Auto-lock idle vaults</span><span class="setting-desc">Unmount a vault left untouched for a while (never forced)</span></span>
					<select id="autoLock" class="mini-select" aria-label="Auto-lock idle vaults">
						<option value="0">Off</option>
						<option value="5">5 minutes</option>
						<option value="15">15 minutes</option>
						<option value="30">30 minutes</option>
						<option value="60">60 minutes</option>
					</select>
				</label>
				<label class="setting-row">
					<span class="setting-text"><span class="setting-name">Lock on sleep</span><span class="setting-desc">Gently lock open vaults when the computer sleeps — walk-away protection</span></span>
					<input type="checkbox" id="lockOnSleep" class="switch">
				</label>
				<label class="setting-row">
					<span class="setting-text"><span class="setting-name">Auto-timestamp</span><span class="setting-desc">Timestamp each new snapshot so the proof chain stays current (needs a network connection)</span></span>
					<input type="checkbox" id="autoAttest" class="switch">
				</label>
				<label class="setting-row">
					<span class="setting-text"><span class="setting-name">Check for updates</span><span class="setting-desc">Off by default for privacy. When on, once a day the app asks the release page whether a newer version exists. It only reads a version number and never downloads or installs anything.</span></span>
					<input type="checkbox" id="autoUpdateCheck" class="switch">
				</label>
				<div class="setting-row">
					<span class="setting-text"><span class="setting-name">Version</span><span class="setting-desc" id="updateStatusText" role="status" aria-live="polite">Check whether a newer version has been published. Downloading stays your choice.</span></span>
					<button type="button" id="updateCheckBtn" class="ghost-btn">Check now</button>
				</div>
				<label class="setting-row">
					<span class="setting-text"><span class="setting-name">Start at login</span><span class="setting-desc">Open the interface automatically each login, and add a launcher icon. Choose this computer only, or reachable from your phone and other devices. It never mounts a vault or stores your password.</span><span class="setting-desc" id="autostartState" hidden></span></span>
					<input type="checkbox" id="autostartToggle" class="switch">
				</label>
				<label class="setting-row">
					<span class="setting-text"><span class="setting-name">Sync speed limit</span><span class="setting-desc">Cap bandwidth for off-site backups and mirrors — never affects an open vault</span></span>
					<select id="bwPreset" class="mini-select w-9em" aria-label="Sync speed limit">
						<option value="">No limit</option>
						<option value="256k">256 KB/s</option>
						<option value="512k">512 KB/s</option>
						<option value="1M">1 MB/s</option>
						<option value="2M">2 MB/s</option>
						<option value="5M">5 MB/s</option>
						<option value="10M">10 MB/s</option>
						<option value="custom">Custom…</option>
					</select>
				</label>
				<label class="setting-row" id="bwCustomRow" hidden>
					<span class="setting-text"><span class="setting-name">Custom limit</span><span class="setting-desc">A rate like 1M or 512k, an upload:download pair like 10M:1M, or an off-peak timetable like 08:00,512k 23:00,off</span></span>
