					<button type="button" id="keysSecKey" class="ghost-btn" hidden>Add a security key</button>
					<button type="button" id="keysAddReadOnly" class="ghost-btn">Read-only password</button>
				</div>
				<div class="key-group-label">Share read access</div>
				<div class="key-grid">
					<button type="button" id="keysReadCap" class="ghost-btn">Read link…</button>
					<select id="keysReadCapExpiry" class="mini-select" aria-label="Read-only link expiry" title="Expiry the recipient's tool enforces on the read link">
						<option value="0">No expiry</option>
						<option value="1">Expires in 1 day</option>
						<option value="7">Expires in 7 days</option>
						<option value="30">Expires in 30 days</option>
						<option value="90">Expires in 90 days</option>
					</select>
					<button type="button" id="keysShares" class="ghost-btn">Who has access…</button>
				</div>
				<details class="advanced">
					<summary>Advanced — Recovery Kit, threshold key, rotate</summary>
					<div class="key-grid">
						<button type="button" id="keysAddThreshold" class="ghost-btn">Threshold key…</button>
						<button type="button" id="keysKit" class="ghost-btn" title="A printable one-page kit that includes a spare recovery key — needs your current password to authorize the key">Recovery Kit…</button>
						<button type="button" id="keysKitId" class="ghost-btn" title="Records only the vault's identity and fingerprint — no key, changes nothing, needs no password">Identity‑only kit…</button>
						<button type="button" id="keysRotate" class="ghost-btn danger">Rotate keys…</button>
					</div>
				</details>
				<div class="key-actions-close"><button type="button" value="cancel" class="ghost-btn">Close</button></div>
			</div>
		</form>
	</dialog>

	<!-- Recovery Kit viewer. The desktop app's WebView cannot open a separate browser window, so when that is not
	     available, the kit's values are shown NATIVELY here (reliable in every WebView, and it keeps the app's feel).
	     "Print or save as PDF" opens the full printable kit in a real browser — the one reliable way to print from a
	     desktop WebView. "Close" returns to the app and clears the values from the page. The values are filled in by
	     app.js and wiped on close, so a one-time recovery key never lingers. -->
	<dialog id="kitDialog" class="dialog kit-dialog">
