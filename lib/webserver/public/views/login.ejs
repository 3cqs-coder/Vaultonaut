<!doctype html>
<html lang="en" data-theme="auto">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title><%= appName %></title>
	<link rel="icon" href="/icon.svg" type="image/svg+xml">
	<script src="/js/theme-boot.js"></script>
	<link rel="stylesheet" href="/fonts/fonts.css">
	<link rel="stylesheet" href="/css/app.css">
</head>
<body class="login-body">
	<main class="login-box">
		<div class="brand login-brand">
			<img class="logo" src="/icon.svg" alt="" width="34" height="34">

			<h1 class="brand-name"><%= appName %></h1>
		</div>
		<p class="login-sub">Enter the password to open this web interface.</p>
		<% if (error) { %><div class="login-error" role="alert"><%= error %></div><% } %>
		<form class="login-form" method="post" action="/login" autocomplete="off">
			<label class="field">
				<span>Password</span>
				<input type="password" name="password" class="mask" autocomplete="current-password" autofocus required>
			</label>
			<button type="submit" class="primary-btn login-submit">Sign in</button>
		</form>
		<% if (typeof webauthn !== 'undefined' && webauthn && webauthn.length) { %>
			<div class="login-sub login-or">or</div>
			<form id="waForm" method="post" action="/login"><input type="hidden" id="waSecret" name="webauthnSecret"></form>
			<button type="button" id="waBtn" class="ghost-btn login-submit">Sign in with Touch ID or a security key</button>
			<script type="application/json" id="wa-descriptors"><%- JSON.stringify(webauthn).replace(/</g, '\\u003c') %></script>
			<script src="/js/webauthn.js"></script>
			<script src="/js/login.js"></script>
		<% } %>
	</main>
</body>
</html>
